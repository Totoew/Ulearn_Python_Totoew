from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import sqlite3
from datetime import datetime


app = FastAPI()

class VacancyInput(BaseModel):
    name: str
    salary: str
    area_name: str

def get_db_connection():
    connection = sqlite3.connect("vacancies.db")
    connection.row_factory = sqlite3.Row
    return connection

@app.get("/vacancies/{vacancy_id}")
def get_vacancy(vacancy_id: int):
    conn = get_db_connection()
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM vacancies WHERE id = ?", (vacancy_id,))
    vacancy = cursor.fetchone()
    conn.close()

    if not vacancy:
        return {"error": "vacancy not found"}

    return {
        "id": vacancy["id"],
        "name": vacancy["name"],
        "salary": vacancy["salary"],
        "area_name": vacancy["area_name"],
        "published_at": vacancy["published_at"],
    }

@app.post("/vacancies")
def create_vacancy(vacancy: VacancyInput):
    conn = get_db_connection()
    cursor = conn.cursor()
    published_at = datetime.now().isoformat()

    cursor.execute("SELECT MAX(id) FROM vacancies")
    max_id = cursor.fetchone()[0] or 0
    new_id = max_id + 1

    cursor.execute(
        "INSERT INTO vacancies (id, name, salary, area_name, published_at) VALUES (?, ?, ?, ?, ?)",
        (new_id, vacancy.name, vacancy.salary, vacancy.area_name, published_at),
    )
    conn.commit()
    conn.close()

    return {"message": "vacancy posted successfully"}

@app.delete("/vacancies/{vacancy_id}")
def delete_vacancy(vacancy_id: int):
    conn = get_db_connection()
    cursor = conn.cursor()

    cursor.execute("SELECT * FROM vacancies WHERE id = ?", (vacancy_id,))
    vacancy = cursor.fetchone()

    if not vacancy:
        return {"error": "vacancy not found"}  

    cursor.execute("DELETE FROM vacancies WHERE id = ?", (vacancy_id,))
    conn.commit()
    conn.close()

    return {"message": "vacancy deleted successfully"}
