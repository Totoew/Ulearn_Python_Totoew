import pandas as pd
import requests
from lxml import etree
from datetime import datetime


START_DATE = '2003-01-01'
END_DATE = '2024-11-01'
CURRENCIES = ['BYR', 'USD', 'EUR', 'KZT', 'UAH', 'AZN', 'KGS', 'UZS', 'GEL']
current_date = datetime.strptime(START_DATE, '%Y-%m-%d')
final_date = datetime.strptime(END_DATE, '%Y-%m-%d')
data_rows = []
while current_date <= final_date:
    date_str = current_date.strftime('%d/%m/%Y')
    response = requests.get(f'http://127.0.0.1:8000/scripts/XML_daily.asp?date_req={date_str}')
    tree = etree.fromstring(response.content)
    year_month = current_date.strftime('%Y-%m')
    row_data = [year_month]
    for currency in CURRENCIES:
        element = tree.xpath(f"//Valute[CharCode='{currency}']")
        value = (float(element[0].find('Value').text.replace(',', '.')) / int(
            element[0].find('Nominal').text)) if element else None
        row_data.append(round(value, 8) if value else None)
    data_rows.append(row_data)
    if current_date.month == 12:
        current_date = current_date.replace(year=current_date.year + 1, month=1)
    else:
        current_date = current_date.replace(month=current_date.month + 1)
df = pd.DataFrame(data_rows, columns=['date'] + CURRENCIES)
df.to_csv('student_works/currency.csv', index=False)
