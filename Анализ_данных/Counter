import pandas as pd
from collections import Counter

vacancies = pd.read_csv('vacancies_small.csv')
name = input()
sort_by = input()
asc = sort_by == 'asc'
filtered_vac = vacancies[vacancies['name'].str.contains(name, case=False, na=False)]
filtered = vacancies['key_skills']

def get_words(text):
    if pd.isnull(text):
        return ""
    else:
        return text.splitlines()

words_list = filtered_vac['key_skills'].apply(lambda x: get_words(x))
all_words = [word for sublist in words_list for word in sublist]
word_counts = Counter(all_words)
top_5_words = word_counts.most_common(5)
my_dict = {}

for word, count in top_5_words:
    my_dict[word] = count

df = pd.DataFrame(list(my_dict.items()), columns=['Навыки', 'Количество упоминаний'])
vac_sorted = df.sort_values(['Количество упоминаний'], ascending=asc)
result = list(zip(vac_sorted['Навыки'], vac_sorted['Количество упоминаний']))
print(result)
