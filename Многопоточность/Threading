# Функция для получения валют
def fetch_currency_batch(urls_batch, id, currencies):
    threads = []
    for url in urls_batch:
        thread = threading.Thread(target=get_currencies, args=(url, id, currencies))
        threads.append(thread)
        thread.start()
    
    # Ожидание завершения всех потоков в батче
    for thread in threads:
        thread.join()



