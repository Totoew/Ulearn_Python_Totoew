import socket
import pandas as pd
import threading

def func(client, df):
    while True:
            msg = client.recv(1024).decode()
            
            record = df[df['Name'] == msg]
            web_address = record['Website'].values[0]
            country = record['Country'].values[0]
            result_str = f'Сайт: {web_address}. Страна: {country}'

            client.send(result_str.encode())
    client.close()

def start_server():
    df = pd.read_csv('organizations.csv') 
    host = "127.0.0.32"
    port = 12345

    server = socket.socket()
    server.bind((host, port))
    server.listen(10)

    while True:
        client, addr = server.accept()
        thread = threading.Thread(target=func, args=(client, df))
        thread.start()

if __name__ == "__main__":
    start_server()
