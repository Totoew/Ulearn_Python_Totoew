import csv
import re


def main():
    input_file = input()
    with open(input_file, 'r', encoding='utf-8-sig') as f:
        csv_reader = csv.reader(f)
        column = next(csv_reader)
        result_dictionary = {}

        for row in csv_reader:
            formatted_list = []
            for item in row:
                if item:
                    formatted_list.append(item)
            if len(formatted_list) >= len(column) / 2:
                if len(result_dictionary) != 0:
                    print()
                result_dictionary = get_res_dictionary(column, row, result_dictionary)
                for current_key in result_dictionary:
                    print(f"{current_key}: {result_dictionary[current_key]}")
                    
def clean_string(string):
    if not string:
        return "Нет данных"
    cleaned_string = re.sub('<[^>]+>', '', string)
    if "\n" in cleaned_string:
        cleaned_string = ('; ').join(cleaned_string.split("\n"))
    cleaned_string = ' '.join(cleaned_string.split())
    return cleaned_string


def get_res_dictionary(column, row, dict):
    for col, val in zip(column, row):
        dict[col] = clean_string(val)
    return dict

if __name__ == '__main__':
    main()
